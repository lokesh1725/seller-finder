# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

# --- MongoDB ---
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=seller_finder
MONGODB_TIMEOUT_MS=5000

# --- CORS / public URLs ---
# Comma-separated allowed frontend origins (production: your Vercel URL).
FRONTEND_URL=http://localhost:5173
PUBLIC_FRONTEND_URL=http://localhost:5173

# --- External web search provider ---
# SEARCH_PROVIDER: brave | bing | none
# Brave: $5 free credit/month (~1000 searches); card required for identity.
# Without a key the API reports search_provider_not_configured honestly.
SEARCH_PROVIDER=none
SEARCH_API_KEY=
SEARCH_API_ENDPOINT=
SEARCH_TIMEOUT_SECONDS=10
SEARCH_MAX_RESULTS=10
SEARCH_CACHE_TTL_HOURS=24

# --- Ollama (local free AI extraction) ---
# Install: https://ollama.com  then: ollama pull llama3.2
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60

# --- Research pipeline ---
RESEARCH_CACHE_TTL_DAYS=30
RESEARCH_CONTACT_TTL_DAYS=14
RESEARCH_MAX_PAGES=6
RESEARCH_ASYNC=true

# --- Admin (protects /api/admin/*) ---
ADMIN_API_TOKEN=

# --- Application login (change these before going live) ---
AUTH_EMAIL=admin@gmail.com
AUTH_PASSWORD=Test@123
AUTH_TOKEN_MAX_AGE=604800

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
