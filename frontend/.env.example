# Empty in development so Vite's proxy forwards /api to localhost:5000.
# In production set to your Render backend URL, e.g. https://seller-finder-api.onrender.com
# NEVER put secret API keys here - VITE_* vars are public to the browser.
VITE_API_BASE_URL=

# Public site URL used to build shareable links (no trailing slash).
# Production: YOUR unique Vercel domain (seller-finder.vercel.app is taken
# by an unrelated third-party app - pick your own subdomain in Vercel).
# Example: https://seller-finder-lokesh.vercel.app
VITE_PUBLIC_SITE_URL=http://localhost:5173
