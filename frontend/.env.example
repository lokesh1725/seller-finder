# Base URL of the deployed Flask backend.
# Leave empty in development so Vite's proxy forwards /api to localhost:5000.
# In production set this to your Render URL, e.g. https://seller-finder-api.onrender.com
VITE_API_BASE_URL=

# Public site URL used to build shareable links (no trailing slash).
VITE_PUBLIC_SITE_URL=http://localhost:5173
